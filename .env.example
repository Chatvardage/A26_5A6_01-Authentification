# Copiez ce fichier en ".env" pour le développement local
# (cp .env.example .env). En Docker, ces mêmes variables sont fournies
# par docker-compose.yml — ne pas committer le fichier ".env" lui-même.

# Identifiants PostgreSQL du compose de développement local. Remplacez-les
# avant tout environnement partagé; ils sont interpolés par docker-compose.
POSTGRES_USER=chatvardage
POSTGRES_PASSWORD=chatvardage
POSTGRES_DB=chatvardage_auth

# Connexion PostgreSQL : utilisateur:mot_de_passe@hôte:port/base.
# Toujours requise — il n'y a pas de mode mock/en mémoire (voir README).
DATABASE_URL=postgres://chatvardage:chatvardage@localhost:5432/chatvardage_auth

# URL réservée au conteneur `auth-api` de docker-compose : même connexion
# que DATABASE_URL, mais avec l'hôte Docker `postgres`. Encoder le nom et le
# mot de passe pour une URL (par exemple, `@` devient `%40`).
DATABASE_URL_DOCKER=postgres://chatvardage:chatvardage@postgres:5432/chatvardage_auth

# Secret utilisé pour signer les JWT — au moins 32 caractères (256 bits),
# sans quoi le service refuse de démarrer (voir config.rs). CHANGER cette
# valeur en production (générer avec `openssl rand -hex 32`, qui produit
# 64 caractères) et ne JAMAIS committer un vrai secret. Laisser vide fait
# échouer le démarrage, afin qu'un `.env.example` copié ne serve jamais de
# secret public.
JWT_SECRET=

# Durée de validité d'un token, en heures.
JWT_DUREE_DE_VIE_HEURES=24

# Port HTTP exposé par le service.
PORT=3001

# Niveau de journalisation (voir la crate `tracing-subscriber`). Valeurs
# usuelles : error, warn, info, debug, trace. Défaut si absent : "info"
# (voir main.rs) — présent ici pour rendre le réglage explicite, comme
# dans docker-compose.yml.
RUST_LOG=info

# Liste blanche CORS obligatoire pour autoriser des requêtes cross-origin,
# origines séparées par des virgules (ex. http://localhost:5173,
# https://admin.exemple.com). Absente, vide ou invalide, aucune origine n'est
# autorisée. Renseigner les origines réellement utilisées avant le démarrage.
#CORS_ORIGINS=
