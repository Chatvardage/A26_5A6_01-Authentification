# Copiez ce fichier en ".env" pour le développement local
# (cp .env.example .env). En Docker, ces mêmes variables sont fournies
# par docker-compose.yml — ne pas committer le fichier ".env" lui-même.

# Mettre à "true" pour développer SANS PostgreSQL (dépôt en mémoire,
# voir README section "Mode mock"). Mettre à "false" (ou retirer la
# ligne) dès que la vraie base de données est prête — c'est la valeur
# utilisée par docker-compose.yml pour la démonstration.
USE_MOCK_DB=true

# Connexion PostgreSQL : utilisateur:mot_de_passe@hôte:port/base.
# Ignorée si USE_MOCK_DB=true.
DATABASE_URL=postgres://chatvardage:chatvardage@localhost:5432/chatvardage_auth

# Secret utilisé pour signer les JWT. CHANGER cette valeur en production
# (ex. générer avec `openssl rand -hex 32`) et ne JAMAIS la committer.
JWT_SECRET=change-moi-avant-la-remise

# Durée de validité d'un token, en heures.
JWT_DUREE_DE_VIE_HEURES=24

# Port HTTP exposé par le service.
PORT=3001
